generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SkillCategory {
  BACKEND
  FRONTEND
  INFRA
  BLOCKCHAIN
}

model Profile {
  id          Int          @id @default(autoincrement())
  slug        String       @unique
  name        String
  title       String
  description String
  location    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  links       Link[]
  skills      Skill[]
  experience  Experience[]
  projects    Project[]
}

model Link {
  id        Int     @id @default(autoincrement())
  profileId Int
  label     String
  url       String
  sortOrder Int     @default(0)
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Skill {
  id        Int           @id @default(autoincrement())
  profileId Int
  name      String
  category  SkillCategory
  sortOrder Int           @default(0)
  profile   Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
  @@index([profileId, category])
}

model Experience {
  id           Int       @id @default(autoincrement())
  profileId    Int
  company      String
  position     String
  location     String?
  startDate    DateTime  @db.Date
  endDate      DateTime? @db.Date
  summary      String?
  achievements String[]
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, startDate])
}

model Project {
  id          Int     @id @default(autoincrement())
  profileId   Int
  name        String
  url         String?
  role        String?
  year        Int?
  description String?
  sortOrder   Int     @default(0)
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}
